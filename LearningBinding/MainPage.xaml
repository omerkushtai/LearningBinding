<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LearningBinding.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout Margin="15">
            <!--  הטקסט והתמונה  -->
            <VerticalStackLayout
                Margin="15,50"
                HorizontalOptions="Center"
                VerticalOptions="Center">


                <Label
                    BindingContext="{Binding Source={x:Reference Name=rotationSlider}}"
                    FontSize="Large"
                    HorizontalOptions="Center"
                    Rotation="{Binding Value}"
                    Opacity="{Binding Value, Source={x:Reference Name=opacitySlider}}"
                    Text="קשה יש רק בלחם"
                    VerticalOptions="Center" />

                <Image
                    x:Name="botImg"
                    Aspect="AspectFit"
                    BindingContext="{Binding Source={x:Reference Name=scaleSlider}}"
                    HeightRequest="150"
                    Scale="{Binding Value,Mode=}"
                    Rotation="{Binding Value, Source={x:Reference Name=rotationSlider}}"
                    Source="dotnet_bot.png"
                    WidthRequest="150" />


            </VerticalStackLayout>
            <!--  Grid 3*2 first column is name second is the slider  -->
            <Grid ColumnDefinitions="*,4*" RowDefinitions="*,*,*">
                <!--  Scale Slider  -->
                <Label
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="הגדלה" />
                <Slider
                    x:Name="scaleSlider"
                    Grid.Column="1"
                    Maximum="5"
                    MaximumTrackColor="#F01616"
                    Minimum="0"
                    MinimumTrackColor="#78EE10"
                    Value="0" />
                <Label
                    Grid.Column="1"
                    Margin="0,15,0,0"
                    Padding="10"
                    HorizontalTextAlignment="Center" />


                <!--  Rotation Slider  -->
                <Label
                    Grid.Row="1"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="סיבוב" />
                <Slider
                    x:Name="rotationSlider"
                    Grid.Row="1"
                    Grid.Column="1"
                    Maximum="360"
                    Minimum="0"
                    ThumbColor="Red"
                    ThumbImageSource="slider.png"
                    Value="1" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,15,0,0"
                    Padding="10"
                    HorizontalTextAlignment="Center"
                    Text="{Binding Value, Source={x:Reference rotationSlider}}" />

                <!--  Opacity Slider  -->
                <Label
                    Grid.Row="2"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="שקיפות" />
                <Slider
                    x:Name="opacitySlider"
                    Grid.Row="2"
                    Grid.Column="1"
                    Maximum="1"
                    Minimum="0"
                    Value="1" />
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,15,0,0"
                    Padding="10"
                    HorizontalTextAlignment="Center"
                  />

            </Grid>

            <Button
                Clicked="OpacityChangeOnClick"
                Text="שנה שקיפות"
                WidthRequest="150" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
